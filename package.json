{
    "name": "cryptotithe",
    "version": "0.8.1",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "test-coveralls": "jest --coverage && cat ./coverage/lcov.info | coveralls && rm -rf ./coverage",
        "build": "next build",
        "dev": "next dev",
        "export": "next export",
        "start": "next start",
        "start-electron": "yarn run build && yarn run export && electron .",
        "electron": "electron .",
        "browserify": "browserify ./react.js -o ./bundle.js -u ./data.json --im",
        "browserify-prod": "browserify ./react.js -o ./bundle.js -u ./data.json --im -g [ envify --NODE_ENV production ] -g uglifyify | uglifyjs --compress --mangle",
        "lint": "yarn run eslint && yarn run stylelint",
        "eslint": "eslint . --ext .ts,.tsx --quiet",
        "stylelint": "stylelint \"index.css\"",
        "full-build-test-ci": "yarn run lint && yarn run test-coveralls",
        "prod-start": "set NODE_ENV=production&& yarn run start",
        "dist": "node ./configs/dist.js",
        "release": "yarn run build && yarn run dist",
        "release-ipfs": "node ./configs/ipfs-release.js && ipfs-deploy ipfs/"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/classnames": "^2.2.9",
        "@types/clone": "^0.1.30",
        "@types/faker": "^4.1.8",
        "@types/file-saver": "^2.0.1",
        "@types/jest": "^24.0.23",
        "@types/node": "^12.12.14",
        "@types/papaparse": "^5.0.2",
        "@types/react": "18.0.26",
        "@types/react-dom": "18.0.9",
        "@types/react-infinite-scroller": "^1.2.3",
        "@types/validator": "13.7.10",
        "@typescript-eslint/eslint-plugin": "^4.6.0",
        "@typescript-eslint/parser": "^4.6.0",
        "browserify": "^16.5.0",
        "coveralls": "^3.0.9",
        "electron": "22.0.0",
        "electron-devtools-installer": "3.2.0",
        "electron-packager": "17.1.1",
        "envify": "^4.1.0",
        "eslint": "^7.12.1",
        "faker": "^4.1.0",
        "jest": "29.3.1",
        "opn-cli": "^5.0.0",
        "stylelint": "^12.0.0",
        "stylelint-config-standard": "^19.0.0",
        "ts-jest": "^29.0.3",
        "typescript": "4.9.4"
    },
    "jest": {
        "testTimeout": 30000,
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "./tsconfig.json"
                }
            ]
        },
        "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json",
            "node"
        ],
        "moduleNameMapper": {
            "@package": "<rootDir>/package.json"
        }
    },
    "stylelint": {
        "extends": "stylelint-config-standard",
        "rules": {
            "color-hex-case": "upper"
        }
    },
    "dependencies": {
        "@blueprintjs/core": "^3.39.0",
        "@koale/useworker": "^4.0.2",
        "apexcharts": "3.25.0",
        "axios": "^0.21.1",
        "classnames": "^2.2.6",
        "clone": "^2.1.2",
        "cryptotithe-wasm": "0.0.4",
        "file-saver": "^2.0.5",
        "font-awesome": "^4.7.0",
        "is-electron": "2.2.1",
        "next": "13.0.7",
        "next-transpile-modules": "^10.0.0",
        "papaparse": "^5.1.0",
        "react": "18.2.0",
        "react-apexcharts": "^1.3.7",
        "react-dom": "18.2.0",
        "react-infinite-scroller": "^1.2.6",
        "sass": "^1.56.2",
        "tachyons": "^4.11.1",
        "validator": "13.7.0"
    }
}
